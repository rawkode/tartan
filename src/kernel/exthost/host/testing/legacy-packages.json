						"slot": "node.tab",
						"id": "board",
						"label": "Board",
						"icon": "kanban",
						"route": "board"
					},
					{
						"slot": "repo.tab",
						"id": "repo-board",
						"label": "Board",
						"icon": "kanban",
						"route": "board",
						"when": "node.kind == 'repo'"
					}
				]
			}
		},
		"protocol": null,
		"migrations": [
			{
				"n": 1,
				"name": "init",
				"sql": ""
			},
			{
				"n": 2,
				"name": "links",
				"sql": ""
			}
		]
	},
	{
