{
	"name": "@tartan/contract",
	"version": "0.4.3",
	"private": true,
	"description": "Tartan contract: types, zod schemas, JSON Schemas, interfaces, facade interfaces and the WIT world",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
