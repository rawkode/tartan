---
import Layout from '../layouts/Layout.astro';
import { css } from '../../styled-system/css';
import { hstack } from '../../styled-system/patterns';
import { form, heading, line, panel, terminal, text } from '../../styled-system/recipes';
import { Badge, Button, Field, Masthead, Segmented, Select, Status } from '../design-system';
import { semanticColors } from '../design-system/theme/academy';

const colors = Object.keys(semanticColors.academy);
const cssVar = (name: string) =>
  `var(--colors-academy-${name.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)})`;

const styles = panel();
const rows = line();
const row = hstack({ gap: '3', flexWrap: 'wrap' });
const label = heading({ size: 'lg' });
const section = css({ display: 'grid', gap: '4', marginBlockEnd: '12' });
const grid = css({
  display: 'grid',
  gridTemplateColumns: 'repeat(auto-fill, minmax(10rem, 1fr))',
  gap: '3',
});
const swatch = css({
  height: '12',
  marginBlockEnd: '1',
  border: 'hairline',
  borderRadius: 'academy-s',
});
---

<Layout title="Design system">
  <Masthead
    slot="masthead"
    title="Design system"
    description="Rawkode Academy tokens, Panda CSS recipes, Vue components and Ark UI behaviour."
  />

  <section class={section}>
    <h2 class={label}>Colour</h2>
    <div class={grid}>
      {colors.map((name) => (
        <div>
          <div class={swatch} style={`background-color: ${cssVar(name)}`} data-swatch={name}></div>
          <code class={css({ overflowWrap: 'anywhere' })}>academy.{name}</code>
        </div>
      ))}
    </div>
  </section>

  <section class={section}>
    <h2 class={label}>Type</h2>
    <div>
      <p class={heading({ size: 'xl' })}>Red Hat Display, xl</p>
      <p class={heading({ size: 'lg' })}>Red Hat Display, lg</p>
      <p>Red Hat Text for navigation, descriptions, forms and reading.</p>
      <p class={text({ mono: true, tone: 'muted', size: 'sm' })}>Red Hat Mono for addresses, identifiers and metadata.</p>
    </div>
  </section>

  <section class={section}>
    <h2 class={label}>List line</h2>
    <div>
      <h3 class={heading({ size: 'rule' })}>A section heading sits on a rule</h3>
      <a class={rows.root} href="/design-system">
        <span class={rows.id}><span class={rows.where}>kiln:lsp</span>#128</span>
        <span class={rows.title}>Lines wrap instead of truncating an address</span>
        <Badge>bug</Badge>
        <Status state="fail">Failing</Status>
        <span class={rows.age}>2h</span>
      </a>
    </div>
  </section>

  <section class={section}>
    <h2 class={label}>Button</h2>
    <div class={row}>
      <Button variant="solid" type="button">Solid</Button>
      <Button type="button">Outline</Button>
      <Button type="button" pressed>Pressed</Button>
      <Button variant="solid" size="sm" type="button">Small solid</Button>
      <Button size="sm" type="button">Small outline</Button>
      <Button type="button" disabled>Disabled</Button>
      <Button href="/design-system">Link</Button>
    </div>
  </section>

  <section class={section}>
    <h2 class={label}>Status and badge</h2>
    <div class={row}>
      <Status state="open">Open</Status>
      <Status state="merged">Merged</Status>
      <Status state="closed">Closed</Status>
      <Status state="pass">Passing</Status>
      <Status state="fail">Failing</Status>
      <Badge>label</Badge>
    </div>
  </section>

  <section class={section}>
    <h2 class={label}>Segmented</h2>
    <Segmented
      client:load
      label="Clone"
      modelValue="repo"
      items={[
        { label: 'Whole repo', value: 'repo' },
        { label: 'One project', value: 'project' },
      ]}
    />
  </section>

  <section class={section}>
    <h2 class={label}>Terminal</h2>
    <code class={terminal()}>forge clone oss/devtools/build/kiln:lsp</code>
  </section>

  <section class={section}>
    <h2 class={label}>Form controls</h2>
    <form class={form()} data-mock>
      <Field label="Name" name="name" helper="Helper text sits below the input." required />
      <Field label="Branch" name="branch" placeholder="workspace-index" mono />
      <Field label="Description" name="body" rows={3} />
      <Select
        client:load
        label="Project"
        name="project"
        modelValue="lsp"
        items={[
          { label: 'core', value: 'core' },
          { label: 'cli', value: 'cli' },
          { label: 'lsp', value: 'lsp' },
        ]}
      />
    </form>
  </section>

  <section class={section}>
    <h2 class={label}>Panel</h2>
    <div class:list={[styles.root, styles.body]}>Panels are for things that stand apart from the rules around them.</div>
    <div class:list={[styles.root, styles.empty]}>Empty state</div>
  </section>
</Layout>
