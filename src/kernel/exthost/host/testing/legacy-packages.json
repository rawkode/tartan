[
	{
		"dir": "work",
		"manifest": {
			"schema": 1,
			"id": "tartan.work",
			"name": "Work",
			"description": "Issues, intents and resolver items: claims with footprints open lanes (work@1)",
			"version": "0.1.0",
			"api": "tartan:ext@0.1.0",
			"runtime": "builtin",
			"entry": {
				"builtin": "tartan.work"
			},
			"storage": {
				"scope": "repo",
				"migrations": [
					"migrations/0001_init.sql",
					"migrations/0002_links.sql",
					"migrations/0003_drop_tournament.sql"
				]
			},
			"provides": [
				"work@1"
			],
			"permissions": {
				"repo": "read",
				"lanes": [
					"open",
					"close"
				],
				"notes": true,
				"notify": true,
				"events.read": [
					"lane.*",
					"changes.*"
				],
				"interfaces.call": [
					"conflicts@1"
				]
			},
			"subscribe": [
				{
					"event": "lane.lost"
				},
				{
					"event": "lane.closed"
				},
				{
					"event": "changes.submitted"
				},
				{
					"event": "changes.abandoned"
				},
				{
					"event": "changes.superseded"
				},
				{
					"event": "changes.landed"
				}
			],
			"contributes": {
				"slots": [
					{
						"slot": "repo.tab",
						"id": "work",
						"label": "Work",
						"icon": "list-checks",
						"route": "work",
						"when": "node.kind == 'repo'"
					},
					{
						"slot": "repo.header.action",
						"id": "new-work",
						"label": "New work",
						"icon": "plus",
						"when": "node.kind == 'repo'",
						"role": 30
					},
					{
						"slot": "work.panel",
						"id": "item",
						"dynamic": true,
						"refreshOn": [
							"work.*",
							"changes.*"
						]
					},
					{
						"slot": "blame.annotation",
						"id": "intent",
						"dynamic": true
					}
				],
				"context": [
					{
						"id": "work-item",
						"maxBytes": 4096,
						"priority": "protocol"
					}
				],
				"protocol": "protocol.md"
			}
		},
		"protocol": "Work: find work with `work_list`, then `work_claim {ref, footprint: {projects, prefixes}, plan}`; declare the projects and path prefixes you expect to touch.\nThe claim gives you your own lane. Start it with the `lane.git.start` command and push only with `lane.git.push` (a lane remote's `main`, or `HEAD:refs/heads/lanes/<id>`); never push `main`.\nA lane still `opening` has no commands yet: poll `lanes_get` until it is `open`. Read `overlaps` and the context: coordinate before editing what another lane declared.\nAdd `Tartan-Work: <ref>` to your commits. Use `work_release` if you give up, and `work_create` (kind `intent`) for follow-up work you discover.\n",
		"migrations": [
			{
				"n": 1,
				"name": "init",
				"sql": ""
			},
			{
				"n": 2,
				"name": "links",
				"sql": ""
			},
			{
				"n": 3,
				"name": "drop_tournament",
				"sql": ""
			}
		]
	},
	{
		"dir": "changes",
		"manifest": {
			"schema": 1,
			"id": "tartan.changes",
			"name": "Changes",
			"description": "Agent-first changes: drafts from lanes, submit, revisions per push, threads (changes@1)",
			"version": "0.1.0",
			"api": "tartan:ext@0.1.0",
			"runtime": "builtin",
			"entry": {
				"builtin": "tartan.changes"
			},
			"storage": {
				"scope": "repo",
				"migrations": [
					"migrations/0001_init.sql",
					"migrations/0002_timeline.sql",
					"migrations/0003_drop_selection_ref.sql"
				]
			},
			"provides": [
				"changes@1"
			],
			"permissions": {
				"repo": "read",
				"lanes": [
					"adopt"
				],
				"notes": true,
				"notify": true,
				"events.read": [
					"lane.*",
					"push.*",
					"review.*",
					"queue.*",
					"land.*",
					"ref.*"
				]
			},
			"subscribe": [
				{
					"event": "lane.opened"
				},
				{
					"event": "lane.closed"
				},
				{
					"event": "push.diffed"
				},
				{
					"event": "review.decided"
				},
				{
					"event": "review.requested"
				},
				{
					"event": "queue.*"
				},
				{
					"event": "land.*"
				},
				{
					"event": "ref.advanced"
				}
			],
			"contributes": {
				"slots": [
					{
						"slot": "repo.tab",
						"id": "changes",
						"label": "Changes",
						"icon": "git-pull-request",
						"route": "changes",
						"when": "node.kind == 'repo'"
					},
					{
						"slot": "change.tab",
						"id": "diff",
						"label": "Diff",
						"icon": "file-diff",
						"route": "diff"
					},
					{
						"slot": "change.tab",
						"id": "revisions",
						"label": "Revisions",
						"icon": "history",
						"route": "revisions"
					},
					{
						"slot": "change.panel",
						"id": "overview",
						"order": -10,
						"dynamic": true,
						"refreshOn": [
							"changes.*",
							"review.*",
							"queue.*",
							"land.*"
						]
					},
					{
						"slot": "change.panel",
						"id": "threads",
						"dynamic": true,
						"refreshOn": [
							"changes.*"
						]
					},
					{
						"slot": "lane.sidebar",
						"id": "change",
						"dynamic": true,
						"refreshOn": [
							"changes.*"
						]
					}
				],
				"protocol": "protocol.md"
			}
		},
		"protocol": "Changes: your lane is a draft change from the moment it opens. Push your commits with the lane's `git.push` command, then call `changes_submit {laneId, title, summary}` when your acceptance criteria pass.\nSubmit after you push: a lane you have not pushed is refused (`empty-lane`). Every later push to the lane is a new revision, and a new revision is reviewed again.\nAnswer review threads with `changes_comment`; `changes_get` shows your revisions and state; `changes_abandon` gives the change up.\n",
		"migrations": [
			{
				"n": 1,
				"name": "init",
				"sql": ""
			},
			{
				"n": 2,
				"name": "timeline",
				"sql": ""
			},
			{
				"n": 3,
				"name": "drop_selection_ref",
				"sql": ""
			}
		]
	},
	{
