# Local secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and fill in.
# Never commit real values. See docs/deploy.md ("Secrets and vars").

# Root key: 32 random bytes, base64url. HKDF derives the seal, web and
# sign-wrap keys from it. Optional: if absent, ForgeDO generates a root key at
# first boot. Generate one with:
#   deno eval 'console.log(btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32)))).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,""))'
TARTAN_SECRET=""

# Previous root key, only while rotating (lazy re-seal).
# TARTAN_SECRET_PREVIOUS=""

# Single-use setup token for the first-run wizard (32 random bytes, base64url).
# Optional: if absent, the Worker logs a claim code instead.
TARTAN_SETUP_TOKEN=""

# Optional GitOps override of the IdP wizard step (the issuer and client id are
# plain vars in wrangler.jsonc; only the client secret belongs here). Optional
# even then: public clients (PKCE S256, `client_auth: none`, the default) have
# no secret. Set it only for a confidential client.
# OIDC_CLIENT_SECRET=""

# One-time token that `deno task destroy` sets to authorize
# `POST /-/admin/idp/deregister`. Leave unset locally (the route answers 404).
# TARTAN_DESTROY_TOKEN=""
