	"files": [
		"src",
		"schema",
		"interfaces",
		"wit"
	],
	"dependencies": {
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@cfworker/json-schema": "4.1.1",
		"@cloudflare/workers-types": "5.20261001.1"
	}
}
